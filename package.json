{
  "name": "dsh-privacy-gateway",
  "version": "0.2.0",
  "description": "Local-first privacy gateway for DeepSeek Harness: masks personal data in conversations before it reaches the model and shows originals only on your screen, and creates redacted safe copies of CSV/Excel files.",
  "type": "module",
  "license": "MIT",
  "author": "Ethan Zhao",
  "homepage": "https://github.com/ethanrise/dsh-privacy-gateway#readme",
  "bugs": {
    "url": "https://github.com/ethanrise/dsh-privacy-gateway/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ethanrise/dsh-privacy-gateway.git"
  },
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "privacy",
    "redaction",
    "pii",
    "excel",
    "csv"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "main": "./lib/index.js",
  "types": "./lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": {
      "default": "./cordis.patch.yml"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "SECURITY.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json --emitDeclarationOnly && node scripts/build-host.mjs && node scripts/build-client.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm test && npm run build",
    "prepack": "npm run check"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-client-connection": ">=0.1.5-alpha.1 <0.1.6-0 || >=0.1.6-0 <0.1.7-0 || >=0.1.7-0 <0.1.8-0 || >=0.1.8-0 <0.1.9-0 || >=0.1.9-0 <0.1.10-0 || >=0.2.0-0 <0.2.1-0 || >=0.1.5 <0.3.0-0",
    "@deepseek-ai/dsh-client-ui-renderer": ">=0.1.5-alpha.1 <0.1.6-0 || >=0.1.6-0 <0.1.7-0 || >=0.1.7-0 <0.1.8-0 || >=0.1.8-0 <0.1.9-0 || >=0.1.9-0 <0.1.10-0 || >=0.2.0-0 <0.2.1-0 || >=0.1.5 <0.3.0-0",
    "@deepseek-ai/dsh-client-ui-sidebar-right": ">=0.1.5-alpha.1 <0.1.6-0 || >=0.1.6-0 <0.1.7-0 || >=0.1.7-0 <0.1.8-0 || >=0.1.8-0 <0.1.9-0 || >=0.1.9-0 <0.1.10-0 || >=0.2.0-0 <0.2.1-0 || >=0.1.5 <0.3.0-0",
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@types/jsdom": "^30.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.0",
    "csv-parse": "^6.1.0",
    "esbuild": "^0.25.0",
    "exceljs": "^4.4.0",
    "jsdom": "^26.1.0",
    "react": "^18.3.1",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
